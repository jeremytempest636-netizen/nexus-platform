"use client";

import { useCallback, useEffect, useState } from "react";
import Link from "next/link";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
} from "recharts";
import { ArrowLeft, ExternalLink, RefreshCw, Server, Terminal } from "lucide-react";

type Deployment = {
  id: string;
  status: string;
  branch: string;
  imageName: string;
  containerId: string | null;
  containerName: string | null;
  containerStatus: string;
  applicationUrl: string | null;
  ports: Array<{
    privatePort?: number;
    publicPort?: number;
    type?: string;
  }>;
  logs: string | null;
  startedAt: string | null;
  finishedAt: string | null;
  createdAt: string;
  project: {
    id: string;
    name: string;
    slug: string;
  };
  triggeredBy: {
    name: string;
    email: string;
    role: string;
  } | null;
  container: {
    id: string;
    name: string | null;
    status: string;
    running: boolean;
    startedAt: string | null;
  } | null;
};

function statusClass(status: string) {
  switch (status) {
    case "SUCCESS":
      return "bg-emerald-500/10 text-emerald-400 border-emerald-500/20";
    case "FAILED":
      return "bg-red-500/10 text-red-400 border-red-500/20";
    case "BUILDING":
    case "DEPLOYING":
    case "PENDING":
      return "bg-amber-500/10 text-amber-400 border-amber-500/20";
    default:
      return "bg-zinc-500/10 text-zinc-400 border-zinc-500/20";
  }
}

export default function DeploymentDetailPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const [deployment, setDeployment] = useState<Deployment | null>(null);

  const [metrics, setMetrics] = useState<{
    cpuPercent: number;
    memoryPercent: number;
    rxBytes: number;
    txBytes: number;
    memoryUsage: number;
    memoryLimit: number;
    timestamp: string;
  } | null>(null);

  const [metricsHistory, setMetricsHistory] = useState<
    Array<{
      cpuPercent: number;
      memoryPercent: number;
      rxBytes: number;
      txBytes: number;
      recordedAt: string;
    }>
  >([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");

  const loadDeployment = useCallback(
    async (manual = false) => {
      try {
        if (manual) {
          setRefreshing(true);
        }

        const resolvedParams = await params;

        const response = await fetch(
          `/api/deployments/${resolvedParams.id}`,
          {
            cache: "no-store",
          }
        );

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data.error || "Failed to load deployment"
          );
        }

        setDeployment(data.deployment);
        setError("");
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Failed to load deployment"
        );
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    [params]
  );

  useEffect(() => {
    const timer = setTimeout(() => {
      void loadDeployment();
    }, 0);

    const interval = setInterval(() => {
      void loadDeployment();
    }, 5000);

    return () => {
      clearTimeout(timer);
      clearInterval(interval);
    };
  }, [loadDeployment]);

  const loadMetricsHistory = useCallback(async () => {
    if (!deployment?.containerId) {
      return;
    }

    try {
      const response = await fetch(
        `/api/docker/${deployment.containerId}/metrics?limit=30`,
        {
          cache: "no-store",
        }
      );

      if (!response.ok) {
        return;
      }

      const data = await response.json();

      const history = (data.metrics ?? []).map(
        (item: {
          cpuPercent: number;
          memoryPercent: number;
          rxBytes: number | string;
          txBytes: number | string;
          recordedAt: string;
        }) => ({
          cpuPercent: Number(item.cpuPercent ?? 0),
          memoryPercent: Number(item.memoryPercent ?? 0),
          rxBytes: Number(item.rxBytes ?? 0),
          txBytes: Number(item.txBytes ?? 0),
          recordedAt: item.recordedAt,
        })
      );

      setMetricsHistory(history.reverse());
    } catch {
      // Metrics history is optional.
    }
  }, [deployment]);

  const loadMetrics = useCallback(async () => {
    if (!deployment?.containerId) {
      return;
    }

    try {
      const response = await fetch(
        `/api/docker/${deployment.containerId}/stats`,
        {
          cache: "no-store",
        }
      );

      if (!response.ok) {
        return;
      }

      const data = await response.json();

      setMetrics({
        cpuPercent: Number(data.cpuPercent ?? 0),
        memoryPercent: Number(data.memoryPercent ?? 0),
        rxBytes: Number(data.rxBytes ?? 0),
        txBytes: Number(data.txBytes ?? 0),
        memoryUsage: Number(data.memoryUsage ?? 0),
        memoryLimit: Number(data.memoryLimit ?? 0),
        timestamp: data.timestamp ?? new Date().toISOString(),
      });
    } catch {
      // Metrics are optional and should not break the deployment page.
    }
  }, [deployment]);

  useEffect(() => {
    if (!deployment?.containerId) {
      return;
    }

    const timer = setTimeout(() => {
      void loadMetrics();
      void loadMetricsHistory();
    }, 0);

    const interval = setInterval(() => {
      void loadMetrics();
      void loadMetricsHistory();
    }, 3000);

    return () => {
      clearTimeout(timer);
      clearInterval(interval);
    };
  }, [deployment?.containerId, loadMetrics, loadMetricsHistory]);
  if (loading) {
    return (
      <main className="min-h-screen bg-zinc-950 p-8 text-zinc-200">
        <div className="mx-auto min-w-0 max-w-7xl">
          Loading deployment...
        </div>
      </main>
    );
  }

  if (error || !deployment) {
    return (
      <main className="min-h-screen bg-zinc-950 p-8 text-zinc-200">
        <div className="mx-auto min-w-0 max-w-7xl space-y-4">
          <Link
            href="/deployments"
            className="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-white"
          >
            <ArrowLeft size={16} />
            Back to Deployments
          </Link>

          <div className="rounded-xl border border-red-500/20 bg-red-500/10 p-5 text-red-400">
            {error || "Deployment not found"}
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-zinc-950 p-6 text-zinc-200 md:p-8">
      <div className="mx-auto min-w-0 max-w-7xl space-y-6">

        <div className="flex flex-col justify-between gap-4 md:flex-row md:items-center">
          <div>
            <Link
              href="/deployments"
              className="mb-3 inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-white"
            >
              <ArrowLeft size={16} />
              Back to Deployments
            </Link>

            <h1 className="text-2xl font-bold">
              Deployment Details
            </h1>

            <p className="mt-1 text-sm text-zinc-500">
              {deployment.project.name}
            </p>
          </div>

          <button
            onClick={() => void loadDeployment(true)}
            className="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2 text-sm hover:bg-zinc-800"
          >
            <RefreshCw
              size={16}
              className={refreshing ? "animate-spin" : ""}
            />
            Refresh
          </button>
        </div>

        <section className="grid gap-4 md:grid-cols-4">

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">Deployment Status</p>
            <span
              className={`mt-3 inline-flex rounded-full border px-3 py-1 text-xs font-semibold ${statusClass(
                deployment.status
              )}`}
            >
              {deployment.status}
            </span>
          </div>

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">Branch</p>
            <p className="mt-3 font-medium text-white">
              {deployment.branch}
            </p>
          </div>

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">Container</p>
            <p className="mt-3 font-medium text-white">
              {deployment.containerStatus}
            </p>
          </div>

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">Docker Image</p>
            <p className="mt-3 truncate font-mono text-sm text-violet-400">
              {deployment.imageName}
            </p>
          </div>

        </section>

        {deployment.applicationUrl && (
          <section className="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6">
            <div className="flex flex-col justify-between gap-4 md:flex-row md:items-center">
              <div>
                <div className="flex items-center gap-2">
                  <Server size={20} className="text-emerald-400" />
                  <h2 className="font-semibold text-white">
                    Application is Running
                  </h2>
                </div>

                <p className="mt-2 font-mono text-sm text-emerald-400">
                  {deployment.applicationUrl}
                </p>
              </div>

              <a
                href={deployment.applicationUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-black hover:bg-emerald-400"
              >
                Open Application
                <ExternalLink size={16} />
              </a>
            </div>
          </section>
        )}

        <section className="grid gap-4 md:grid-cols-4">

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">CPU Usage</p>
            <p className="mt-2 text-2xl font-bold text-white">
              {metrics ? `${metrics.cpuPercent.toFixed(2)}%` : "--"}
            </p>
          </div>

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">Memory Usage</p>
            <p className="mt-2 text-2xl font-bold text-white">
              {metrics
                ? `${metrics.memoryPercent.toFixed(2)}%`
                : "--"}
            </p>
          </div>

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">Network RX</p>
            <p className="mt-2 text-2xl font-bold text-white">
              {metrics
                ? `${(metrics.rxBytes / 1024 / 1024).toFixed(2)} MB`
                : "--"}
            </p>
          </div>

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
            <p className="text-xs text-zinc-500">Network TX</p>
            <p className="mt-2 text-2xl font-bold text-white">
              {metrics
                ? `${(metrics.txBytes / 1024 / 1024).toFixed(2)} MB`
                : "--"}
            </p>
          </div>

        </section>
        <section className="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
          <div className="mb-6">
            <h2 className="font-semibold text-white">
              Container Resource History
            </h2>
            <p className="mt-1 text-xs text-zinc-500">
              CPU and memory usage from the latest container metrics.
            </p>
          </div>

          <div className="h-[320px] w-full">
            {metricsHistory.length > 0 ? (
              <ResponsiveContainer width="100%" height="100%">
                <LineChart data={metricsHistory}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#27272a" />

                  <XAxis
                    dataKey="recordedAt"
                    tickFormatter={(value) =>
                      new Date(value).toLocaleTimeString("id-ID", {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                      })
                    }
                    tick={{ fontSize: 11, fill: "#71717a" }}
                  />

                  <YAxis
                    unit="%"
                    tick={{ fontSize: 11, fill: "#71717a" }}
                  />

                  <Tooltip
                    labelFormatter={(value) =>
                      new Date(String(value)).toLocaleString("id-ID")
                    }
                    formatter={(value, name) => [
                      `${Number(value).toFixed(2)}%`,
                      name === "cpuPercent"
                        ? "CPU"
                        : "Memory",
                    ]}
                  />

                  <Line
                    type="monotone"
                    dataKey="cpuPercent"
                    stroke="#8b5cf6"
                    strokeWidth={2}
                    dot={false}
                    name="cpuPercent"
                  />

                  <Line
                    type="monotone"
                    dataKey="memoryPercent"
                    stroke="#10b981"
                    strokeWidth={2}
                    dot={false}
                    name="memoryPercent"
                  />
                </LineChart>
              </ResponsiveContainer>
            ) : (
              <div className="flex h-full items-center justify-center text-sm text-zinc-500">
                Waiting for metrics history...
              </div>
            )}
          </div>
        </section>
        <section className="grid gap-6 lg:grid-cols-2">

          <div className="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
            <div className="mb-5 flex items-center gap-2">
              <Server size={18} className="text-violet-400" />
              <h2 className="font-semibold text-white">
                Container Information
              </h2>
            </div>

            <div className="space-y-4 text-sm">
              <div>
                <p className="text-zinc-500">Container Name</p>
                <p className="mt-1 font-mono text-zinc-200">
                  {deployment.containerName || "-"}
                </p>
              </div>

              <div>
                <p className="text-zinc-500">Container ID</p>
                <p className="mt-1 break-all font-mono text-xs text-zinc-400">
                  {deployment.containerId || "-"}
                </p>
              </div>

              <div>
                <p className="text-zinc-500">Status</p>
                <p className="mt-1 text-zinc-200">
                  {deployment.containerStatus}
                </p>
              </div>

              <div>
                <p className="text-zinc-500">Ports</p>

                <div className="mt-2 space-y-2">
                  {deployment.ports.length > 0 ? (
                    deployment.ports.map((port, index) => (
                      <div
                        key={`${port.privatePort}-${port.publicPort}-${index}`}
                        className="rounded-lg bg-zinc-950 p-3 font-mono text-xs"
                      >
                        {port.publicPort
                          ? `localhost:${port.publicPort}`
                          : "-"}
